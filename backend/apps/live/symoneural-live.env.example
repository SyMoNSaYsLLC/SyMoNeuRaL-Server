# SyMoNeuRaL Live — operator configuration.
#
#   cp symoneural-live.env.example symoneural-live.env
#   chmod 600 symoneural-live.env          # it will hold a real password
#   # then edit symoneural-live.env, never this file
#
# This file is the TEMPLATE and is tracked in git; `symoneural-live.env` is not and cannot be
# (`.gitignore` carries `*.env` with `!*.env.example`, and `scripts/lib/archive-guard.sh`
# refuses any archive containing a real `.env`). Never put a value in this file.
#
# A variable already exported WINS over this file, so a systemd unit or a one-off
# `SYMONEURAL_LIVE_ENABLED=0 python3 ...` overrides it rather than fighting it.
#
# NOTHING HERE IS NEEDED TO WATCH THE STREAM. The video path reads a directory and holds no
# credential. These keys only add the telemetry line — scene, fps, dropped frames — and a
# blank file leaves the page working with that line reading "not configured".


# --- the surface switch ------------------------------------------------------------------
# Unlike every other togglable app here, this one defaults ON when the variable is absent.
# The others cost something when switched on (the GPU, an outbound fetcher, a miner); this
# one serves files out of a directory that is empty until OBS is configured to write there,
# so a default-off version could only produce a tab that is broken on arrival. Set it to 0
# to switch the whole surface off; /api/live/state then answers 200 saying so.
SYMONEURAL_LIVE_ENABLED=1


# --- obs-websocket -----------------------------------------------------------------------
# Where OBS's websocket is. This process is the CLIENT and connects outward to loopback; port
# 28001 is never proxied, never exposed, and needs no router port forward. See obs.py's
# docstring for why proxying it would publish the stream-control credential.
#
# Leave the host at 127.0.0.1. obs-websocket v5 has no bind-address setting, so OBS itself
# listens on 0.0.0.0 and is LAN-reachable; pointing this at anything but loopback would send
# the password across a network for no gain.
SYMONEURAL_OBS_HOST=127.0.0.1
SYMONEURAL_OBS_PORT=28001

# The password from OBS: Tools → WebSocket Server Settings → Show Connect Info.
#
# READ THIS BEFORE PASTING ONE IN. A credential that has been displayed is spent. If that
# dialog has been screenshotted, shared, or shown on a stream — and it shows the password in
# plain text next to a QR code encoding the same value — press **Generate Password** first
# and paste the NEW one here. Rotating costs one click and one restart.
#
# Empty is a supported state, not a broken one: the bridge reports itself unconfigured, names
# this variable in the detail line, and the video keeps playing.
SYMONEURAL_OBS_PASSWORD=


# --- what a visitor may see --------------------------------------------------------------
# The current OBS scene name is withheld from /api/live/state by default. It is the one field
# that describes the setup rather than the stream — scene names tend to be things like
# "Desktop" or "Webcam + terminal" — and a visitor does not need it. Set to 1 to publish it.
SYMONEURAL_LIVE_PUBLIC_SCENE=0
