# SyMoNeuRaL Miner GPU — operator configuration.  MINING IS OFF BY DEFAULT.
#
#   cp miner.env.example miner.env      # then edit miner.env, not this file
#   cd /home/google/Symoneural/backend/apps && python3 -m cryptominer selftest
#
# This file is READ, not sourced: `KEY=value` per line, `#` comments, no shell expansion,
# no command substitution. Only the four SYMONEURAL_MINER_* / SYMONEURAL_MINING_* keys below are
# honoured — anything else in here is ignored on purpose, because this ends up in the
# environment of the serving interpreter and a `LD_PRELOAD=` line must not.
#
# A variable that is already exported WINS over this file, so a systemd unit or a one-off
# `SYMONEURAL_MINING_ENABLED=1 python3 ...` overrides it rather than fighting it.
#
# Every value below is deliberately unset or off. Copying this file and forgetting about
# it starts nothing: the rack unit stays `offline` and POST /api/gpuminer/control refuses.

# 1 = the surface exists at all. Anything else, including empty, means off.
SYMONEURAL_MINING_ENABLED=0

# The miner to run, with all of its arguments — pool, wallet, worker name. There is no
# default and there will never be one: a default here means an unconfigured machine starts
# hashing for somebody, on somebody else's electricity, the first time an endpoint is hit.
#
# A KawPow miner built from source on this box (see contrib/build-kawpowminer.sh) lands at
#   /home/google/Symoneural/contrib/kawpowminer/build/kawpowminer/kawpowminer
# measured on the RTX 5070 Ti at 48.36 MH/s mean, 52.63 MH/s peak over a 150 s
# `-U -M 500000` simulation run on 2026-08-17. Use it like this, with YOUR pool and
# YOUR wallet — the example below is a placeholder and will not authenticate:
#
#   SYMONEURAL_MINER_CMD=/home/google/Symoneural/contrib/kawpowminer/build/kawpowminer/kawpowminer -U -P stratum+tcp://YOUR_WALLET.rig1@rvn.pool.example:10000
#
# To prove the plumbing without a pool or a wallet, benchmark mode is a real miner run:
#
#   SYMONEURAL_MINER_CMD=/home/google/Symoneural/contrib/kawpowminer/build/kawpowminer/kawpowminer -U -M 500000
#
SYMONEURAL_MINER_CMD=

# The shared secret every /api/gpuminer/* request must present as X-Symoneural-Token. Generate
# one; do not reuse SYMONEURAL_ASIC_TOKEN, which gates the separate ASIC surface.
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SYMONEURAL_MINER_TOKEN=

# Which card. One GPU on this box, so 0.
SYMONEURAL_MINER_GPU=0
