\
# --- REQUIRED: explicit enable flag ---
SYM_MINING_ENABLED=0

# --- Miner command (set this to your miner binary + args) ---
# Example (placeholder):
# SYM_MINER_CMD=C:\Tools\miners\miner.exe --algo x --pool pool.example:1234 --user WALLET.RIG --pass x --devices 0
SYM_MINER_CMD=

# --- Optional: GPU selection (NVIDIA) ---
SYM_GPU_INDEX=0

# --- Runtime behavior ---
SYM_STATUS_INTERVAL_S=5
SYM_LOG_LEVEL=INFO
SYM_WORKDIR=.

# --- Where status gets written ---
SYM_STATUS_FILE=data/status.json

# --- Optional: nvidia-smi path (auto if on PATH) ---
SYM_NVIDIA_SMI=nvidia-smi
