[Unit]
# TEMPLATE. @@ROOT@@ is replaced with the repo root by ops/install-service.sh at
# install time. systemd has no notion of a relative path, so this is the only way the
# unit can live in a repo that gets cloned anywhere.
Description=SyMoNeuRaL inference API (chat, image, calc, remix)
# StartLimit* live in [Unit], NOT [Service], and this pair sat in [Service] until 2026-09-03
# where systemd silently ignored them -- `systemd-analyze verify` says "Unknown key
# 'StartLimitIntervalSec' in section [Service], ignoring", and `systemctl show` measured the
# effective window as 10s, the built-in default, identical to a unit that declares nothing.
# So the crash-loop protection the comment below describes had never once applied.
StartLimitIntervalSec=120
StartLimitBurst=5
Documentation=https://symoneural.com/docs
# The GPU has to be there before we start; nvidia-persistenced keeps the driver initialised
# so the first request after a reboot does not pay driver-load latency.
After=network-online.target nvidia-persistenced.service
Wants=network-online.target
# Caddy proxies /api, /docs and /openapi.json to us. It can start without us -- the static
# site must serve whether or not inference is up -- so this is a soft ordering only.
# Before=caddy.service is kept and is a NO-OP on this host, which is the whole problem this
# second line fixes. `caddy.service` was the production owner of :80 and :443 until the
# 2026-08-26 cutover; it is now disabled, and systemd treats an ordering constraint against a
# unit that never starts as satisfied-by-absence. So this unit had NO boot ordering against the
# process that actually serves, and "start before the web server" quietly stopped being true.
#
# Both lines, not a replacement: a host still running stock Caddy needs the first, and
# ordering against a unit that is absent there costs nothing either. Ordering is declarative
# and cheap; guessing which shape a host is at install time is not.
Before=caddy.service
Before=symoneural-web.service

[Service]
Type=exec
User=google
Group=google
WorkingDirectory=@@ROOT@@

# A crash or an unclean shutdown leaves the governor lock directory behind. The pid inside
# it is dead, so the next acquire would break it anyway -- but doing it here means the very
# first request after a restart is not delayed by a stale-lock poll, and the rack does not
# briefly show a holder that no longer exists.
ExecStartPre=-/usr/bin/env bash -c '@@ROOT@@/scripts/gpu-governor.sh release chat >/dev/null 2>&1; @@ROOT@@/scripts/gpu-governor.sh release image >/dev/null 2>&1 || true'
ExecStart=/usr/bin/python3 @@ROOT@@/backend/server.py
# Give in-flight generations a chance to finish rather than cutting a visitor off mid-answer.
# Slightly above the 120 s job timeout so a job that is already doomed is not waited on twice.
TimeoutStopSec=140
KillMode=mixed
KillSignal=SIGTERM
# The engines are children in their own process groups; make sure nothing survives us
# holding several gigabytes of VRAM.
ExecStopPost=-/usr/bin/env bash -c 'pkill -f "[l]lama-server"; pkill -f "[s]d-cli"; @@ROOT@@/scripts/gpu-governor.sh release chat >/dev/null 2>&1; @@ROOT@@/scripts/gpu-governor.sh release image >/dev/null 2>&1 || true'

Restart=always
RestartSec=3
# If it is crash-looping, stop rather than thrashing the GPU. Five failures in two minutes
# means something is wrong that restarting will not fix.

Environment=PYTHONUNBUFFERED=1
Environment=SYMONEURAL_PORT=8800

# Logs go to the journal; see ops/symoneural-api.logrotate for the app's own file.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=symoneural-api

# --- hardening -------------------------------------------------------------------------
# Deliberately moderate. The service needs /dev/nvidia*, the model directory and the site
# directory it writes generated images into, so the aggressive presets are not usable here.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=no
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# The image surface runs the T5 text encoder on the CPU (te=cpu) precisely to keep it out of
# VRAM, so system RAM use is legitimately large. This is a backstop against a leak, not a
# working limit.
MemoryMax=24G
TasksMax=512

[Install]
WantedBy=multi-user.target
