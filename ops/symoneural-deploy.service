[Unit]
# TEMPLATE, and a SYSTEM unit -- not a user one. @@ROOT@@ is replaced with the repo root by
# ops/install-service.sh, which deliberately does NOT install this: it prints the sudo lines
# and leaves the decision to a person, the same way it treats symoneural-api.service.
#
# This is a system unit because the webroot is www-data owned and scripts/deploy.sh installs
# into it as www-data. Nothing here can be done from the user session, which is exactly why
# the job kept not happening.
#
# ## What this is for
#
# PROJECT-TASKS.md #73 item 6: "Automate the deploy so 'online' survives a reboot without a
# person." The failure it names is not hypothetical and is recorded in this repo twice: the
# tuner -> streamer rename shipped into site/ and stopped there, because publishing needs root
# and every generator run does not, so the staging tree moved and the live tree did not. A step
# that needs a password is a step that is performed exactly as often as somebody remembers.
Description=Publish the staged SyMoNeuRaL site to /var/www/symoneural
Documentation=file://@@ROOT@@/scripts/deploy.sh
Documentation=file://@@ROOT@@/docs/SERVER-READY.md

# Caddy serves the webroot from disk and picks up changes without a reload, so this is an
# ordering preference and not a dependency. `Before=` without `Requires=` means a failed
# deploy leaves the previous tree in place and Caddy still comes up serving it -- which is the
# correct outcome, because the last good tree is a working site and a half-published one
# is not.
After=local-fs.target
# Before=caddy.service is kept and is a NO-OP on this host, which is the whole problem this
# second line fixes. `caddy.service` was the production owner of :80 and :443 until the
# 2026-08-26 cutover; it is now disabled, and systemd treats an ordering constraint against a
# unit that never starts as satisfied-by-absence. So this unit had NO boot ordering against the
# process that actually serves, and "start before the web server" quietly stopped being true.
#
# Both lines, not a replacement: a host still running stock Caddy needs the first, and
# ordering against a unit that is absent there costs nothing either. Ordering is declarative
# and cheap; guessing which shape a host is at install time is not.
Before=caddy.service
Before=symoneural-web.service

# If the staging tree is not there, this box is not the build box, and the unit should be
# skipped rather than failed. A red unit that is red for a reason nobody can act on trains
# people to ignore `systemctl --failed`, which is the one place a real failure would show.
ConditionPathIsDirectory=@@ROOT@@/site

[Service]
Type=oneshot
# RemainAfterExit=yes, and this is a state contract rather than a preference.
#
# With `no`, a oneshot that succeeds lands on ActiveState=inactive / SubState=dead with an
# EMPTY ActiveEnterTimestamp. `systemctl status` then shows an ENABLED unit as inactive(dead)
# after a perfectly successful boot-time publish, which is indistinguishable at a glance from
# "it never ran" -- and the only way to tell them apart is to read the journal. An operator
# checking whether the site published at boot should be able to see that it did.
#
# With `yes` the unit stays active(exited) after the process exits, carrying a populated
# activation timestamp: the publish is recorded in the unit's own state, not only in the log.
#
# THE COST, stated because it changes an operator workflow: once the unit is active, a second
# `systemctl start` is a NO-OP until it is stopped or restarted. Republishing is therefore
# `systemctl restart`, not `start` -- corrected in the [Install] note below. Nothing else in
# this repository invokes the unit; every documented manual republish calls
# `sudo scripts/deploy.sh --prune` directly, which is unaffected.
#
# NOT Restart=always. This is a finite publication job, not a daemon: it copies files between
# two local directories and exits, with PrivateNetwork=yes so it could not serve anything even
# if it wanted to. Restarting it on a loop would republish the site forever.
RemainAfterExit=yes
WorkingDirectory=@@ROOT@@

# ## Why --prune, and why that is not a decision this file makes lightly
#
# deploy.sh copies site/ into the webroot and, on EVERY run, snapshots the live index.html to
# `index.prev-<timestamp>.html`. Run by hand a few times a month that is a useful undo. Run by
# a machine at every boot it is unbounded growth of publicly-served stale copies of the front
# page -- and the webroot already carries two of them, alongside tuner.html and
# tuner-watch.html, which are pages the site renamed away from and still serves to anyone who
# knows the URL.
#
# So an unattended deploy that only ever adds is worse than no unattended deploy. `--prune` is
# what makes the job idempotent: it deletes everything in the webroot with no counterpart in
# site/, except the backup taken on this run. After it, the webroot is exactly the staged tree
# plus one undo, whatever it was before.
#
# The risk is real and is documented in deploy.sh's own header: a prune has already destroyed
# the only copy of a file that existed nowhere else. The lesson recorded there is the one this
# unit obeys -- "a comment promising a file is safe is not a mechanism". Anything that must
# survive belongs in site/ (where it is tracked) or outside the webroot entirely. If you need
# to see what would go first, run the script by hand: without --prune it lists every orphan and
# deletes nothing.
#
# Overridable rather than hardcoded, so the decision stays visible and reversible:
#     sudo systemctl edit symoneural-deploy.service     ->  Environment=SYMONEURAL_DEPLOY_ARGS=
Environment=SYMONEURAL_DEPLOY_ARGS=--prune
EnvironmentFile=-/etc/symoneural/deploy.env

# Unquoted $VAR is word-split by systemd, so an empty value passes no argument at all rather
# than an empty one -- which matters, because deploy.sh tests "${1:-}" = "--prune".
ExecStart=/usr/bin/env bash @@ROOT@@/scripts/deploy.sh $SYMONEURAL_DEPLOY_ARGS

# deploy.sh verifies that every local asset reference in the published tree resolves on disk,
# and exits non-zero when one does not. That check is the reason this unit is allowed to fail:
# a tree whose pages reference files that are not there is a broken site, and it should show up
# in `systemctl --failed` rather than be published quietly. Do not add SuccessExitStatus.
TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=symoneural-deploy

# --- hardening -------------------------------------------------------------------------
# It runs as root because it installs files owned by www-data; everything else is taken away.
# No GPU, no lock, no network: this copies files between two local directories, and if that
# ever stops being true it stops being safe to run unattended at boot.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
# The two paths it genuinely writes: the webroot it publishes into, and nothing else. The repo
# is NOT writable here -- this unit reads the staged tree and must never be able to modify it,
# which is what keeps a deploy from being able to corrupt the thing it deploys from.
ReadWritePaths=/var/www/symoneural
ReadOnlyPaths=@@ROOT@@
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryMax=512M
TasksMax=64

[Install]
# Installed but NOT enabled by ops/install-service.sh, and that is the point of the split: the
# unit file makes the boot-time deploy possible, and arming it is a deliberate root action by
# the person who owns the box, taken after reading the --prune paragraph above.
#
#     sudo systemctl enable symoneural-deploy.service     # arm it for the next boot
#     sudo systemctl restart symoneural-deploy.service    # publish right now
#
# `restart`, NOT `start`: RemainAfterExit=yes leaves the unit active after a successful
# publish, so a second `start` does nothing at all. This line said `start` until
# 2026-08-26 and would have silently stopped working the moment that flag was set.
#
# Deliberately not a .path unit watching site/. The generators rewrite pages in place and
# build_cachebust.py stamps them afterwards, so a watcher would fire mid-sequence and publish
# a tree whose stylesheet references had been stripped and not yet re-stamped -- pages
# cacheable for a week with no way to invalidate them, which is the exact failure
# .claude/CLAUDE.md warns about. Boot and manual are both points where the tree is at rest.
WantedBy=multi-user.target
