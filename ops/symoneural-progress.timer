[Unit]
# TEMPLATE, USER unit. Installed by ops/install-service.sh.
#
# Garrett: "i still want my progress.html but it should be automated at this point", and
# before it, "we dont need task for things that run when we look away". The page was being
# regenerated by hand, which meant it was accurate exactly as often as somebody remembered --
# and the time it was wrong, it was wrong for over an hour with four cancelled steps still
# advertised as pending work. A page that reports state has to be regenerated by something
# that cannot forget.
Description=Rebuild the SyMoNeuRaL progress page every two minutes

[Timer]
Unit=symoneural-progress.service

# Two minutes. The page's own meta-refresh is 60 s, so this is the coarser of the two and the
# one that actually bounds staleness: worst case the browser reloads a file that is up to two
# minutes old. Cheaper would be tempting -- but the inputs are four small text files and a
# `git log`, and the whole run is well under a second, so there is nothing to save.
OnUnitActiveSec=2min

# Fire 30 s after the user session comes up rather than immediately, so a page rebuilt at boot
# is not competing with the API's startup for a machine that is also loading a driver.
OnStartupSec=30s

# Without this the timer only ever fires while a session is alive. Lingering is on for this
# user, so Persistent means a machine that was off overnight rebuilds the page once on the way
# back up instead of serving yesterday's until the two-minute mark.
Persistent=true

# Nothing else is competing for this slot and the job is sub-second, so the spread is small --
# it exists only so the tick never lands on the same instant as another timer forever.
AccuracySec=10s
RandomizedDelaySec=5s

[Install]
WantedBy=timers.target
